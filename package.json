{
  "name": "systems-modeler-collaborative",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --local",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "check": "node scripts/check.mjs && node scripts/ui-audit.mjs && node scripts/environment-audit.mjs && node scripts/wrangler-audit.mjs && node scripts/interaction-audit.mjs && node scripts/visual-audit.mjs && npm run conformance-audit && npm run notation-completeness-audit && node scripts/qualification-matrix-audit.mjs && npm run verification-planning-audit && npm run element-support-audit",
    "test": "node --test",
    "ui-audit": "node scripts/ui-audit.mjs",
    "environment-audit": "node scripts/environment-audit.mjs",
    "dev:remote": "wrangler dev --config wrangler.jsonc --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "versions:dry-run": "wrangler versions upload --dry-run --config wrangler.jsonc",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "interaction-audit": "node scripts/interaction-audit.mjs",
    "import-audit": "node --test test/import-profile.test.mjs",
    "conformance-matrix": "node scripts/generate-conformance-matrix.mjs",
    "conformance-audit": "node scripts/conformance-audit.mjs",
    "notation-completeness-audit": "node scripts/notation-completeness-audit.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:browser": "playwright test",
    "test:browser:headed": "PWHEADED=1 playwright test",
    "browser:version": "node scripts/browser-version.mjs",
    "verification-planning-audit": "node scripts/verification-planning-audit.mjs",
    "element-support-audit": "node scripts/element-support-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sparticuz/chromium": "^141.0.0",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
