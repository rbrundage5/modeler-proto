{
  "name": "systems-modeler-collaborative",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --local",
    "build": "wrangler deploy --dry-run --outdir dist/browser --config wrangler.jsonc",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:check": "node --test test/desktop-*.test.mjs && node scripts/desktop-security-audit.mjs",
    "desktop:package": "npm run desktop:build && electron-builder --win zip --x64 --publish never",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "check": "node scripts/check.mjs && node scripts/ui-audit.mjs && node scripts/environment-audit.mjs && node scripts/wrangler-audit.mjs && node scripts/interaction-audit.mjs && node scripts/visual-audit.mjs && npm run conformance-audit",
    "test": "node --test",
    "ui-audit": "node scripts/ui-audit.mjs",
    "environment-audit": "node scripts/environment-audit.mjs",
    "dev:remote": "wrangler dev --config wrangler.jsonc --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "versions:dry-run": "wrangler versions upload --dry-run --config wrangler.jsonc",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "interaction-audit": "node scripts/interaction-audit.mjs",
    "import-audit": "node --test test/import-profile.test.mjs",
    "conformance-matrix": "node scripts/generate-conformance-matrix.mjs",
    "conformance-audit": "node scripts/conformance-audit.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "wrangler": "^4.118.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.systemsmodeler.desktop",
    "productName": "Systems Modeler",
    "asar": true,
    "directories": { "output": "dist/windows" },
    "artifactName": "Systems-Modeler-${version}-windows-${arch}.${ext}",
    "files": ["desktop/**", "public/**", "package.json"],
    "win": { "target": [{ "target": "zip", "arch": ["x64"] }] }
  }
}
